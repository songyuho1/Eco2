// Game interfaces
export interface ESGScenario {
  id: string;
  title: string;
  description: string;
  representative: keyof typeof ESG_REPRESENTATIVES;
  category: 'environment' | 'social' | 'governance' | 'money';
  year: number;
  
  leftOption: {
    text: string;
    effects: ScoreEffects;
    consequences?: string;
  };
  
  rightOption: {
    text: string;
    effects: ScoreEffects;
    consequences?: string;
  };
  
  educationalData?: {
    fact: string;
    source: string;
    realWorldExample?: string;
  };
}

interface ScoreEffects {
  environment: number;
  social: number;
  governance: number;
  money: number;
}

